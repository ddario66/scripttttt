-- ==========================================================--
--  CAMLOCK + SHOOT LOGIC
-- ==========================================================--
local targetEnemy = nil
local camlockConn = nil
local shootConn = nil
local triggerConn = nil
local autoShootThread = nil

function getCurrentGun()
    local char = LocalPlayer.Character
    if not char then return nil end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then
        for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
            if item:IsA("Tool") then tool = item; break end
        end
    end
    return tool
end

function getEnemies()
    local enemies = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Team ~= LocalPlayer.Team then
            local c = p.Character
            if c and c:FindFirstChild("Head") and c:FindFirstChild("Humanoid") and c.Humanoid.Health > 0 then
                table.insert(enemies, p)
            end
        end
    end
    return enemies
end

function getClosestEnemy()
    local enemies = getEnemies()
    if #enemies == 0 then return nil end
    local center = Camera.ViewportSize / 2
    local best, bestD = nil, math.huge
    for _, e in ipairs(enemies) do
        local sp, on = Camera:WorldToScreenPoint(e.Character.Head.Position)
        if on then
            local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
            if d < bestD then bestD = d; best = e end
        end
    end
    return best
end

function isVisible(enemy)
    local c = enemy.Character
    if not c then return false end
    local h = c:FindFirstChild("Head")
    if not h then return false end
    local origin = Camera.CFrame.Position
    local dir = (h.Position - origin).Unit
    local dist = (h.Position - origin).Magnitude
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, c, Camera}
    return workspace:Raycast(origin, dir * dist, params) == nil
end

function isLockedOn(enemy)
    if not enemy then return false end
    local dirToHead = (enemy.Character.Head.Position - Camera.CFrame.Position).Unit
    local angle = math.acos(math.clamp(Camera.CFrame.LookVector:Dot(dirToHead), -1, 1))
    return math.deg(angle) <= Settings.LockAngle
end

function isAlive(enemy)
    local c = enemy and enemy.Character
    local h = c and c:FindFirstChild("Humanoid")
    return h and h.Health > 0
end

function updateCamlock()
    local anyEnabled = Settings.SilentAimPC or Settings.SilentAimMobile
    if not anyEnabled then return end
    local enemy = getClosestEnemy()
    if enemy and isVisible(enemy) then
        targetEnemy = enemy
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, enemy.Character.Head.Position)
    else
        targetEnemy = nil
    end
end

local function fireGun()
    if isFiring then return end
    if not onFireFn then return end
    local gun = getCurrentGun()
    if not gun then return end
    local stats = gun:FindFirstChild("Stats")
    if not stats then return end
    local clip = stats:FindFirstChild("ClipSize")
    if clip and clip.Value <= 0 then
        debug.setupvalue(onFireFn, 7, false)
        if reloadFn then task.spawn(reloadFn) end
        local reloadTime = stats:FindFirstChild("ReloadTime")
        task.wait(reloadTime and reloadTime.Value or 2)
        return
    end
    isFiring = true
    debug.setupvalue(onFireFn, 7, true)
    pcall(onFireFn)
    local fireRate = stats:FindFirstChild("FireRate")
    task.wait(fireRate and fireRate.Value or 0.1)
    isFiring = false
end

function shoot()
    if not getCurrentGun() then return end
    if not targetEnemy or not isAlive(targetEnemy) then
        targetEnemy = nil
        return
    end
    if not isVisible(targetEnemy) or not isLockedOn(targetEnemy) then return end
    fireGun()
end

function triggerShoot()
    if not getCurrentGun() then return end
    local enemy = getClosestEnemy()
    if enemy and isAlive(enemy) and isVisible(enemy) and isLockedOn(enemy) then
        fireGun()
    end
end

local function UpdateCombat()
    local anyEnabled = Settings.SilentAimPC or Settings.SilentAimMobile
    if anyEnabled then
        LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
    else
        LocalPlayer.CameraMode = Enum.CameraMode.Classic
    end

    if anyEnabled and not camlockConn then
        camlockConn = RunService.RenderStepped:Connect(updateCamlock)
    elseif not anyEnabled and camlockConn then
        camlockConn:Disconnect(); camlockConn = nil; targetEnemy = nil
    end

    if Settings.SilentAimPC and not shootConn then
        shootConn = RunService.Heartbeat:Connect(function()
            shoot()
        end)
    elseif not Settings.SilentAimPC and shootConn then
        shootConn:Disconnect(); shootConn = nil
    end

    if Settings.Triggerbot and not triggerConn then
        triggerConn = RunService.Heartbeat:Connect(function()
            triggerShoot()
        end)
    elseif not Settings.Triggerbot and triggerConn then
        triggerConn:Disconnect(); triggerConn = nil
    end

    if Settings.BringEnemy then StartBringEnemy() else StopBringEnemy() end
end

-- ==========================================================--
--  HITBOX EXPANDER
-- ==========================================================--
local hitboxConn = nil
local origRaycast = nil

local function MakeHitboxBig(character)
    if not character or not character.Parent then return end
    local Head = character:FindFirstChild("Head")
    local Root = character:FindFirstChild("HumanoidRootPart")
    local Torso = character:FindFirstChild("UpperTorso")
    if Head then Head.Size = Vector3.new(15, 15, 15); Head.Transparency = 0.8 end
    if Root then Root.Size = Vector3.new(15, 15, 15) end
    if Torso then Torso.Size = Vector3.new(15, 15, 15) end
end

local function ResetHitbox(character)
    if not character or not character.Parent then return end
    local Head = character:FindFirstChild("Head")
    local Root = character:FindFirstChild("HumanoidRootPart")
    local Torso = character:FindFirstChild("UpperTorso")
    if Head then Head.Size = Vector3.new(2, 1, 1); Head.Transparency = 0 end
    if Root then Root.Size = Vector3.new(2, 2, 1) end
    if Torso then Torso.Size = Vector3.new(2, 2, 1) end
end

local function EnableHitbox()
    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) and player.Character then MakeHitboxBig(player.Character) end
    end
    hitboxConn = RunService.Heartbeat:Connect(function()
        for _, player in ipairs(Players:GetPlayers()) do
            if isEnemy(player) and player.Character then
                local head = player.Character:FindFirstChild("Head")
                if head and head.Size.Magnitude < 10 then MakeHitboxBig(player.Character) end
            end
        end
    end)
    origRaycast = workspace.Raycast
    workspace.Raycast = function(self, origin, direction, params)
        local result = origRaycast(self, origin, direction, params)
        local alreadyHitEnemy = false
        if result and result.Instance then
            local parent = result.Instance.Parent
            if parent and parent:FindFirstChild("Humanoid") and parent ~= LocalPlayer.Character then
                alreadyHitEnemy = true
            end
        end
        if not alreadyHitEnemy then
            local maxRange = 1000
            local bestHit = nil
            local bestDist = maxRange
            for _, plr in ipairs(Players:GetPlayers()) do
                if isEnemy(plr) and plr.Character then
                    local char = plr.Character
                    local partsToCheck = { char:FindFirstChild("Head"), char:FindFirstChild("UpperTorso"), char:FindFirstChild("HumanoidRootPart") }
                    for _, part in ipairs(partsToCheck) do
                        if part and part:IsA("BasePart") then
                            local hit, pos = part:FindPartOnRayWithIgnoreList(Ray.new(origin, direction * maxRange), {})
                            if hit == part then
                                local dist = (origin - pos).Magnitude
                                if dist < bestDist then
                                    bestDist = dist
                                    bestHit = { Instance = part, Position = pos, Normal = Vector3.new(0, 1, 0), Material = part.Material, Distance = dist }
                                end
                            end
                        end
                    end
                end
            end
            if bestHit then return bestHit end
        end
        return result
    end
end

local function DisableHitbox()
    if hitboxConn then hitboxConn:Disconnect(); hitboxConn = nil end
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then ResetHitbox(player.Character) end
    end
    if origRaycast then workspace.Raycast = origRaycast; origRaycast = nil end
end

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function(char)
        wait(0.2)
        if Settings.HitboxExpand and isEnemy(player) then MakeHitboxBig(char) end
    end)
end)

