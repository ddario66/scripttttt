--  ESP SYSTEMS
-- ==========================================================--
local ESP_UPDATE_RATE = 1 / 30
local ESP_MAX_DISTANCE = 1200
local espTimer = 0
local BoxESP = {}
local BoxESP_Active = false
local BOX_COLOR = Color3.fromRGB(255, 35, 35)
local BOX_THICKNESS = 2
local BOX_CORNER = 0.25

local function NewBoxLine()
    local line = Drawing.new("Line")
    line.Visible = false; line.Color = BOX_COLOR; line.Thickness = BOX_THICKNESS; line.Transparency = 1
    return line
end

local function CreateBoxESP(player)
    if BoxESP[player] then return end
    BoxESP[player] = { Player = player, Lines = {} }
    for i = 1, 8 do BoxESP[player].Lines[i] = NewBoxLine() end
end

local function RemoveBoxESP(player)
    local data = BoxESP[player]
    if not data then return end
    for _, line in ipairs(data.Lines) do pcall(function() line.Visible = false; line:Remove() end) end
    BoxESP[player] = nil
end

local function HideBox(data)
    for _, line in ipairs(data.Lines) do line.Visible = false end
end

local function UpdateBox(data)
    local player = data.Player
    local character = player.Character
    if not character then HideBox(data); return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or humanoid.Health <= 0 or not root then HideBox(data); return end
    if not isEnemy(player) then HideBox(data); return end
    local dist = (Camera.CFrame.Position - root.Position).Magnitude
    if dist > ESP_MAX_DISTANCE then HideBox(data); return end
    local cf, size = character:GetBoundingBox()
    local half = size / 2
    local corners = {
        cf * CFrame.new(-half.X, half.Y, -half.Z), cf * CFrame.new(half.X, half.Y, -half.Z),
        cf * CFrame.new(-half.X, -half.Y, -half.Z), cf * CFrame.new(half.X, -half.Y, -half.Z),
        cf * CFrame.new(-half.X, half.Y, half.Z), cf * CFrame.new(half.X, half.Y, half.Z),
        cf * CFrame.new(-half.X, -half.Y, half.Z), cf * CFrame.new(half.X, -half.Y, half.Z),
    }
    local minX, maxX = math.huge, -math.huge
    local minY, maxY = math.huge, -math.huge
    local found = false
    for _, corner in ipairs(corners) do
        local point, visible = Camera:WorldToViewportPoint(corner.Position)
        if point.Z > 0 then
            found = true
            minX = math.min(minX, point.X); maxX = math.max(maxX, point.X)
            minY = math.min(minY, point.Y); maxY = math.max(maxY, point.Y)
        end
    end
    if not found then HideBox(data); return end
    local w = maxX - minX; local h = maxY - minY
    if w < 2 or h < 2 then HideBox(data); return end
    local cx = w * BOX_CORNER; local cy = h * BOX_CORNER
    local pulse = (math.sin(os.clock() * 4) + 1) / 2
    local bright = Color3.fromRGB(190, 0, 0):Lerp(Color3.fromRGB(255, 45, 45), pulse)
    for _, line in ipairs(data.Lines) do line.Color = bright; line.Visible = true end
    data.Lines[1].From = Vector2.new(minX, minY); data.Lines[1].To = Vector2.new(minX + cx, minY)
    data.Lines[2].From = Vector2.new(minX, minY); data.Lines[2].To = Vector2.new(minX, minY + cy)
    data.Lines[3].From = Vector2.new(maxX, minY); data.Lines[3].To = Vector2.new(maxX - cx, minY)
    data.Lines[4].From = Vector2.new(maxX, minY); data.Lines[4].To = Vector2.new(maxX, minY + cy)
    data.Lines[5].From = Vector2.new(minX, maxY); data.Lines[5].To = Vector2.new(minX + cx, maxY)
    data.Lines[6].From = Vector2.new(minX, maxY); data.Lines[6].To = Vector2.new(minX, maxY - cy)
    data.Lines[7].From = Vector2.new(maxX, maxY); data.Lines[7].To = Vector2.new(maxX - cx, maxY)
    data.Lines[8].From = Vector2.new(maxX, maxY); data.Lines[8].To = Vector2.new(maxX, maxY - cy)
end

local NameESP = {}
local NameESP_Active = false
local NAME_RED = Color3.fromRGB(255, 35, 35)
local NAME_DARK = Color3.fromRGB(120, 0, 0)

local function NewNameText(size)
