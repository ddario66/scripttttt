local bringEnemyConn = nil
local heldEnemies = {}
local USE_TEAM_CHECK = true

local function isEnemy(player)
    if player == LocalPlayer then return false end
    if USE_TEAM_CHECK then return player.Team ~= LocalPlayer.Team else return true end
end

local function releasePlayer(player)
    if heldEnemies[player] then
        local char = player.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then root.Anchored = false; root.CFrame = heldEnemies[player].originalCFrame end
        end
        heldEnemies[player] = nil
    end
end

local function releaseAll()
    for player in pairs(heldEnemies) do releasePlayer(player) end
end

local function isPositionVisible(worldPos, ignoreChar)
    local screenPos, onScreen = Camera:WorldToScreenPoint(worldPos)
    if not onScreen then return false end
    local viewport = Camera.ViewportSize
    if screenPos.X < -50 or screenPos.X > viewport.X + 50 or screenPos.Y < -50 or screenPos.Y > viewport.Y + 50 then return false end
    local origin = Camera.CFrame.Position
    local direction = (worldPos - origin).Unit
    local distance = (worldPos - origin).Magnitude
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignoreList = {LocalPlayer.Character, Camera}
    if ignoreChar then table.insert(ignoreList, ignoreChar) end
    params.FilterDescendantsInstances = ignoreList
    local result = workspace:Raycast(origin, direction * distance, params)
    return result == nil
end

local function StartBringEnemy()
    if bringEnemyConn then return end
    LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
    bringEnemyConn = RunService.Heartbeat:Connect(function()
        if not Settings.BringEnemy then return end
        local myChar = LocalPlayer.Character
        if not myChar then return end
        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        local targetPos = myRoot.CFrame + myRoot.CFrame.LookVector * 3
        for _, player in ipairs(Players:GetPlayers()) do
            if isEnemy(player) then
                local targetChar = player.Character
                if targetChar then
                    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
                    local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
                    if targetRoot and humanoid and humanoid.Health > 0 then
                        if heldEnemies[player] then
                            if not isPositionVisible(heldEnemies[player].originalHeadPos, targetChar) then
                                releasePlayer(player)
                            else
                                targetRoot.Anchored = true; targetRoot.CFrame = targetPos
                                targetRoot.Velocity = Vector3.zero; targetRoot.RotVelocity = Vector3.zero
                            end
                        else
                            local head = targetChar:FindFirstChild("Head")
                            if head and isPositionVisible(head.Position, targetChar) then
                                heldEnemies[player] = { originalCFrame = targetRoot.CFrame, originalHeadPos = head.Position }
                                targetRoot.Anchored = true; targetRoot.CFrame = targetPos
                                targetRoot.Velocity = Vector3.zero; targetRoot.RotVelocity = Vector3.zero
                            end
                        end
                    else releasePlayer(player) end
                else releasePlayer(player) end
            end
        end
    end)
end

local function StopBringEnemy()
    if bringEnemyConn then bringEnemyConn:Disconnect(); bringEnemyConn = nil end
    releaseAll()
    if not Settings.SilentAimPC and not Settings.SilentAimMobile then
        LocalPlayer.CameraMode = Enum.CameraMode.Classic
    end
end

-- ==========================================================--
--  FLY SYSTEM
-- ==========================================================--
local flying = false
local bg = nil
local bv = nil
local ctrl = {f = 0, b = 0, l = 0, r = 0}
local lastctrl = {f = 0, b = 0, l = 0, r = 0}
local maxspeed = 50
local speed = 0

local function Fly()
    local plr = LocalPlayer
    local torso = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    local humanoid = plr.Character and plr.Character:FindFirstChild("Humanoid")
    if not torso or not humanoid then return end
    humanoid.Died:Connect(function() flying = false end)
    bg = Instance.new("BodyGyro", torso); bg.P = 9e4; bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9); bg.CFrame = torso.CFrame
    bv = Instance.new("BodyVelocity", torso); bv.Velocity = Vector3.new(0, 0.1, 0); bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    repeat wait()
        if not flying then break end
        if not plr.Character or not plr.Character.Parent then break end
        torso = plr.Character:FindFirstChild("HumanoidRootPart")
        humanoid = plr.Character:FindFirstChild("Humanoid")
        if not torso or not humanoid then break end
        humanoid.PlatformStand = true
        if ctrl.l + ctrl.r ~= 0 or ctrl.f + ctrl.b ~= 0 then
            speed = speed + 0.5 + (speed / maxspeed)
            if speed > maxspeed then speed = maxspeed end
        elseif speed ~= 0 then
            speed = speed - 1
            if speed < 0 then speed = 0 end
        end
        local cam = workspace.CurrentCamera
        if (ctrl.l + ctrl.r) ~= 0 or (ctrl.f + ctrl.b) ~= 0 then
            bv.Velocity = ((cam.CFrame.LookVector * (ctrl.f + ctrl.b)) + ((cam.CFrame * CFrame.new(ctrl.l + ctrl.r, (ctrl.f + ctrl.b) * 0.2, 0).p) - cam.CFrame.p)) * speed
            lastctrl = {f = ctrl.f, b = ctrl.b, l = ctrl.l, r = ctrl.r}
        elseif speed ~= 0 then
            bv.Velocity = ((cam.CFrame.LookVector * (lastctrl.f + lastctrl.b)) + ((cam.CFrame * CFrame.new(lastctrl.l + lastctrl.r, (lastctrl.f + lastctrl.b) * 0.2, 0).p) - cam.CFrame.p)) * speed
        else
            bv.Velocity = Vector3.new(0, 0.1, 0)
        end
        bg.CFrame = cam.CFrame * CFrame.Angles(-math.rad((ctrl.f + ctrl.b) * 50 * speed / maxspeed), 0, 0)
    until not flying
    ctrl = {f = 0, b = 0, l = 0, r = 0}; lastctrl = {f = 0, b = 0, l = 0, r = 0}; speed = 0
    if bg then bg:Destroy(); bg = nil end
    if bv then bv:Destroy(); bv = nil end
    if humanoid then humanoid.PlatformStand = false end
end

local function StartFly() if flying then return end; flying = true; Fly() end
local function StopFly() flying = false end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.W then ctrl.f = 1 end
    if input.KeyCode == Enum.KeyCode.S then ctrl.b = -1 end
    if input.KeyCode == Enum.KeyCode.A then ctrl.l = -1 end
    if input.KeyCode == Enum.KeyCode.D then ctrl.r = 1 end
end)
UserInputService.InputEnded:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.W then ctrl.f = 0 end
    if input.KeyCode == Enum.KeyCode.S then ctrl.b = 0 end
    if input.KeyCode == Enum.KeyCode.A then ctrl.l = 0 end
    if input.KeyCode == Enum.KeyCode.D then ctrl.r = 0 end
end)

