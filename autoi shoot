local function UpdateName(data)
    local player = data.Player
    local character = player.Character
    if not character then HideName(data); return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    local head = character:FindFirstChild("Head")
    if not humanoid or humanoid.Health <= 0 or not root or not head then HideName(data); return end
    if not isEnemy(player) then HideName(data); return end
    local dist = (Camera.CFrame.Position - root.Position).Magnitude
    if dist > ESP_MAX_DISTANCE then HideName(data); return end
    local position, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.7, 0))
    if not onScreen or position.Z <= 0 then HideName(data); return end
    local vp = Camera.ViewportSize
    if position.X < -100 or position.X > vp.X + 100 or position.Y < -100 or position.Y > vp.Y + 100 then HideName(data); return end
    local sp = Vector2.new(position.X, position.Y)
    local pulse = (math.sin(os.clock() * 4) + 1) / 2
    local animCol = NAME_DARK:Lerp(NAME_RED, pulse)
    data.Marker.Text = "◆"; data.Marker.Position = sp + Vector2.new(0, -17); data.Marker.Color = animCol; data.Marker.Size = 12; data.Marker.Visible = true
    data.Name.Text = string.upper(player.DisplayName); data.Name.Position = sp + Vector2.new(0, -2); data.Name.Color = NAME_RED; data.Name.Size = 14; data.Name.Visible = true
    data.Distance.Text = "[" .. math.floor(dist) .. "M]"; data.Distance.Position = sp + Vector2.new(0, 13); data.Distance.Color = animCol; data.Distance.Size = 11; data.Distance.Visible = true
end

local SkelESP = {}
local SkelESP_Active = false
local SKEL_RED_1 = Color3.fromRGB(255, 35, 35)
local SKEL_RED_2 = Color3.fromRGB(145, 0, 0)
local SKEL_THICKNESS = 1.7
local R15 = {
    {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
}
local R6 = {
    {"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"}, {"Torso", "Left Leg"}, {"Torso", "Right Leg"},
}

local function NewSkelLine()
    local line = Drawing.new("Line")
    line.Visible = false; line.Thickness = SKEL_THICKNESS; line.Transparency = 1; line.Color = SKEL_RED_1
    return line
end

local function HideSkel(data) for _, line in ipairs(data.Lines) do line.Visible = false end end

local function CreateSkelESP(player)
    if SkelESP[player] then return end
    SkelESP[player] = { Player = player, Lines = {} }
    for i = 1, 15 do SkelESP[player].Lines[i] = NewSkelLine() end
end

local function RemoveSkelESP(player)
    local data = SkelESP[player]
    if not data then return end
    for _, line in ipairs(data.Lines) do pcall(function() line.Visible = false; line:Remove() end) end
    SkelESP[player] = nil
end

local function UpdateSkel(data)
    local player = data.Player
    local character = player.Character
    if not character then HideSkel(data); return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or humanoid.Health <= 0 or not root then HideSkel(data); return end
    if not isEnemy(player) then HideSkel(data); return end
    local dist = (Camera.CFrame.Position - root.Position).Magnitude
    if dist > ESP_MAX_DISTANCE then HideSkel(data); return end
    local bones = character:FindFirstChild("UpperTorso") and R15 or R6
    local pulse = (math.sin(os.clock() * 5) + 1) / 2
    for i, bone in ipairs(bones) do
        local part1 = character:FindFirstChild(bone[1])
        local part2 = character:FindFirstChild(bone[2])
        local line = data.Lines[i]
        if part1 and part2 and line then
            local p1, v1 = Camera:WorldToViewportPoint(part1.Position)
            local p2, v2 = Camera:WorldToViewportPoint(part2.Position)
            if v1 and v2 and p1.Z > 0 and p2.Z > 0 then
                line.From = Vector2.new(p1.X, p1.Y); line.To = Vector2.new(p2.X, p2.Y)
                line.Color = (i % 2 == 0) and SKEL_RED_2:Lerp(SKEL_RED_1, pulse) or SKEL_RED_1:Lerp(SKEL_RED_2, pulse * 0.45)
                line.Visible = true
            else line.Visible = false end
        elseif line then line.Visible = false end
    end
    for i = #bones + 1, #data.Lines do data.Lines[i].Visible = false end
end

local function SyncESP()
    if Settings.ESPEnemies and not BoxESP_Active then
        BoxESP_Active = true
        for _, p in ipairs(Players:GetPlayers()) do if isEnemy(p) then CreateBoxESP(p) end end
    elseif not Settings.ESPEnemies and BoxESP_Active then
        BoxESP_Active = false; for p in pairs(BoxESP) do RemoveBoxESP(p) end
    end
    if Settings.ESPName and not NameESP_Active then
        NameESP_Active = true
        for _, p in ipairs(Players:GetPlayers()) do if isEnemy(p) then CreateNameESP(p) end end
    elseif not Settings.ESPName and NameESP_Active then
        NameESP_Active = false; for p in pairs(NameESP) do RemoveNameESP(p) end
    end
    if Settings.ESPSkeleton and not SkelESP_Active then
        SkelESP_Active = true
        for _, p in ipairs(Players:GetPlayers()) do if isEnemy(p) then CreateSkelESP(p) end end
    elseif not Settings.ESPSkeleton and SkelESP_Active then
        SkelESP_Active = false; for p in pairs(SkelESP) do RemoveSkelESP(p) end
    end
end

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function(char)
        wait(0.2)
        if Settings.HitboxExpand and isEnemy(p) then MakeHitboxBig(char) end
    end)
    if isEnemy(p) then
        if BoxESP_Active then CreateBoxESP(p) end
        if NameESP_Active then CreateNameESP(p) end
        if SkelESP_Active then CreateSkelESP(p) end
    end
end)

Players.PlayerRemoving:Connect(function(p)
    RemoveBoxESP(p); RemoveNameESP(p); RemoveSkelESP(p)
end)

-- ==========================================================--
--  MAIN LOOP (protected with pcall)
-- ==========================================================--
local oldPC, oldMobile, oldTrigger = false, false, false
local oldESP, oldName, oldSkel = false, false, false
local oldHitbox = false
local oldNoRecoil = false
local oldRapidFire = false
local oldBringEnemy = false
local oldAutoGunType = false

findGunFunctions()

RunService.Heartbeat:Connect(function()
    -- Wrap each feature activation to prevent one error from breaking the loop
    pcall(function()
        if Settings.SilentAimPC ~= oldPC or Settings.SilentAimMobile ~= oldMobile then
            oldPC = Settings.SilentAimPC; oldMobile = Settings.SilentAimMobile
        end
        if Settings.Triggerbot ~= oldTrigger then oldTrigger = Settings.Triggerbot end
    end)

    pcall(function()
        if Settings.BringEnemy ~= oldBringEnemy then
            oldBringEnemy = Settings.BringEnemy
            if Settings.BringEnemy then StartBringEnemy() else StopBringEnemy() end
        end
    end)

    pcall(function()
        if Settings.FlyEnabled then StartFly() else StopFly() end
    end)

    pcall(function()
        if Settings.AutoGunType ~= oldAutoGunType then
            oldAutoGunType = Settings.AutoGunType
            if Settings.AutoGunType then StartAutoGunType() else StopAutoGunType() end
        end
    end)

    pcall(UpdateCombat)

    pcall(function()
        if Settings.ESPEnemies ~= oldESP or Settings.ESPName ~= oldName or Settings.ESPSkeleton ~= oldSkel then
            oldESP = Settings.ESPEnemies; oldName = Settings.ESPName; oldSkel = Settings.ESPSkeleton
            SyncESP()
        end
    end)

    pcall(function()
        if Settings.HitboxExpand ~= oldHitbox then
            oldHitbox = Settings.HitboxExpand
            if Settings.HitboxExpand then EnableHitbox() else DisableHitbox() end
        end
    end)

    pcall(function()
        if Settings.NoRecoil ~= oldNoRecoil then
            oldNoRecoil = Settings.NoRecoil
            if Settings.NoRecoil then StartNoRecoil() else StopNoRecoil() end
        end
    end)

    pcall(function()
        if Settings.RapidFire ~= oldRapidFire then
            oldRapidFire = Settings.RapidFire
            if Settings.RapidFire then StartRapidFire() else StopRapidFire() end
        end
    end)
end)

RunService.RenderStepped:Connect(function(dt)
    espTimer = espTimer + dt
    if espTimer < ESP_UPDATE_RATE then return end
    espTimer = 0
    if BoxESP_Active then for _, data in pairs(BoxESP) do pcall(UpdateBox, data) end end
    if NameESP_Active then for _, data in pairs(NameESP) do pcall(UpdateName, data) end end
    if SkelESP_Active then for _, data in pairs(SkelESP) do pcall(UpdateSkel, data) end end
end)
