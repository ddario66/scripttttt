-- ==========================================================--
local autoGunTypeConn = nil
local autoGunTypeLoopConn = nil
local GUN_TYPE_VALUE = "Auto"
local playerAutoGunTypeConns = {}

local function ApplyGunType(instance)
    for _, descendant in ipairs(instance:GetDescendants()) do
        if descendant.Name == "GunType" and descendant:IsA("ValueBase") then
            if descendant.Value ~= GUN_TYPE_VALUE then descendant.Value = GUN_TYPE_VALUE end
        end
    end
end

local function HandlePlayerGuns(player)
    local function HandleCharacter(char) if char then ApplyGunType(char) end end
    local function HandleBackpack(bp)
        if bp then
            ApplyGunType(bp)
            bp.ChildAdded:Connect(function(child) ApplyGunType(child) end)
        end
    end
    if player.Character then HandleCharacter(player.Character) end
    if player:FindFirstChild("Backpack") then HandleBackpack(player.Backpack) end
    if not playerAutoGunTypeConns[player] then playerAutoGunTypeConns[player] = {} end
    if not playerAutoGunTypeConns[player].charAdded then
        playerAutoGunTypeConns[player].charAdded = player.CharacterAdded:Connect(HandleCharacter)
    end
    if not playerAutoGunTypeConns[player].childAdded then
        playerAutoGunTypeConns[player].childAdded = player.ChildAdded:Connect(function(child)
            if child.Name == "Backpack" then HandleBackpack(child) end
        end)
    end
end

local function StartAutoGunType()
    if autoGunTypeConn then return end
    for _, p in ipairs(Players:GetPlayers()) do HandlePlayerGuns(p) end
    autoGunTypeConn = Players.PlayerAdded:Connect(function(p) HandlePlayerGuns(p) end)
    autoGunTypeLoopConn = RunService.Heartbeat:Connect(function()
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then ApplyGunType(p.Character) end
            if p:FindFirstChild("Backpack") then ApplyGunType(p.Backpack) end
        end
    end)
end

local function StopAutoGunType()
    if autoGunTypeConn then autoGunTypeConn:Disconnect(); autoGunTypeConn = nil end
    if autoGunTypeLoopConn then autoGunTypeLoopConn:Disconnect(); autoGunTypeLoopConn = nil end
    for p, conns in pairs(playerAutoGunTypeConns) do
        for _, conn in pairs(conns) do pcall(function() conn:Disconnect() end) end
    end
    playerAutoGunTypeConns = {}
end

