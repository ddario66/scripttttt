local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local autoShooting = false
local reloading = false

local function getGun()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChildWhichIsA("Tool")
end

local function startAutoShoot()
    if autoShooting or reloading then return end
    local gun = getGun()
    if not gun then
        warn("[AutoShoot] No gun equipped")
        return
    end
    autoShooting = true
    mouse1press()
    warn("[AutoShoot] ON - " .. gun.Name)
end

local function stopAutoShoot()
    autoShooting = false
    reloading = false
    mouse1release()
    warn("[AutoShoot] OFF")
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.U then
        if autoShooting then
            stopAutoShoot()
        else
            startAutoShoot()
        end
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    autoShooting = false
    reloading = false
    task.wait(1)
    startAutoShoot()
end)

RunService.Heartbeat:Connect(function()
    if not autoShooting then return end
    local gun = getGun()
    if not gun then
        stopAutoShoot()
        return
    end
    local stats = gun:FindFirstChild("Stats")
    if not stats then return end
    local clip = stats:FindFirstChild("ClipSize")
    if clip and clip.Value <= 0 and not reloading then
        reloading = true
        mouse1release()
        task.wait(0.1)
        local weaponHud = LocalPlayer.PlayerGui:FindFirstChild("WeaponHud")
        if weaponHud then
            local reloadBtn = weaponHud:FindFirstChild("Reload")
            if reloadBtn and reloadBtn.Visible then
                local absPos = reloadBtn.AbsolutePosition
                local absSize = reloadBtn.AbsoluteSize
                mousemoveabs(absPos.X + absSize.X / 2, absPos.Y + absSize.Y / 2)
                task.wait(0.05)
                mouse1click()
            end
        end
        local reloadTime = stats:FindFirstChild("ReloadTime")
        task.wait(reloadTime and reloadTime.Value or 2)
        reloading = false
        if autoShooting then
            mouse1press()
        end
    end
end)

task.wait(1)
startAutoShoot()
warn("[AutoShoot] Loaded - Auto-shooting ON. Press U to toggle.")
