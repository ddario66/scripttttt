local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local autoShooting = false
local onFireFn = nil
local reloadFn = nil
local activeThread = nil

local function findFunctions()
    local found = 0
    for _, fn in filtergc("function", {}, false) do
        local info = debug.getinfo(fn)
        if info and info.source == "=Workspace." .. LocalPlayer.Name .. ".FirearmLocal" then
            if info.name == "OnFire" then
                onFireFn = fn
                found += 1
            elseif info.name == "Reload" then
                reloadFn = fn
                found += 1
            end
            if found >= 2 then break end
        end
    end
    return found >= 1
end

local function getGun()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChildWhichIsA("Tool")
end

-- UI
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "AutoShootGUI"
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 160, 0, 60)
frame.Position = UDim2.new(0.5, -80, 0, 20)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
frame.BorderSizePixel = 0
frame.Parent = screenGui
frame.Active = true
frame.Draggable = true
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

local toggleBtn = Instance.new("TextButton")
toggleBtn.Size = UDim2.new(1, -16, 0, 40)
toggleBtn.Position = UDim2.new(0, 8, 0, 10)
toggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
toggleBtn.Text = "AUTO: OFF"
toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleBtn.TextScaled = true
toggleBtn.Font = Enum.Font.GothamBold
toggleBtn.BorderSizePixel = 0
toggleBtn.Parent = frame
Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 8)

local function stopAuto()
    autoShooting = false
    toggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
    toggleBtn.Text = "AUTO: OFF"
    if onFireFn then
        debug.setupvalue(onFireFn, 7, false)
    end
    if activeThread then
        task.cancel(activeThread)
        activeThread = nil
    end
end

local function startAuto()
    if autoShooting then return end
    if not onFireFn and not findFunctions() then
        warn("[AutoShoot] No gun script found - equip a gun!")
        return
    end
    local gun = getGun()
    if not gun then
        warn("[AutoShoot] Equip a gun first!")
        return
    end
    autoShooting = true
    toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
    toggleBtn.Text = "AUTO: ON"

    activeThread = task.spawn(function()
        while autoShooting do
            local gun = getGun()
            if not gun then
                stopAuto()
                return
            end
            local stats = gun:FindFirstChild("Stats")
            if not stats then
                stopAuto()
                return
            end
            local clip = stats:FindFirstChild("ClipSize")
            if clip and clip.Value <= 0 then
                debug.setupvalue(onFireFn, 7, false)
                if reloadFn then
                    task.spawn(reloadFn)
                end
                local reloadTime = stats:FindFirstChild("ReloadTime")
                task.wait(reloadTime and reloadTime.Value or 2)
            else
                debug.setupvalue(onFireFn, 7, true)
                local ok, err = pcall(onFireFn)
                if not ok then
                    warn("[AutoShoot] Fire error:", err)
                    task.wait(0.1)
                end
            end
        end
    end)
end

toggleBtn.MouseButton1Click:Connect(function()
    if autoShooting then
        stopAuto()
    else
        startAuto()
    end
end)

screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
findFunctions()

LocalPlayer.CharacterAdded:Connect(function()
    stopAuto()
    onFireFn = nil
    reloadFn = nil
    task.wait(2)
    findFunctions()
end)

warn("[AutoShoot] Loaded - Click the button to toggle.")
